# idealo MCP (streamable HTTP, OAuth client credentials)
IDEALO_MCP_URL=https://mcp.idealo.com/mcp
IDEALO_TOKEN_URL=
IDEALO_CLIENT_ID=
IDEALO_CLIENT_SECRET=

# Model: Vercel AI Gateway (OpenAI-compatible). On Vercel the OIDC token is used, no key needed there.
AI_GATEWAY_API_KEY=
# optional, default anthropic/claude-sonnet-5.5; ids from https://ai-gateway.vercel.sh/v1/models
LLM_MODEL=
# optional: another OpenAI-compatible endpoint instead of the gateway (e.g. Nebius Token Factory)
LLM_BASE_URL=
LLM_API_KEY=

# Neon Postgres (set by the Vercel integration in production). Empty = in-memory store for local dev.
DATABASE_URL=

# Accounts (e-mail code sign-in)
AUTH_SECRET=            # random string, signs the stored code hashes
RESEND_API_KEY=         # empty = test mode (code only in the log)
MAIL_FROM=              # default: Wishfit <login@bemany.tech>
AUTH_DEV_CODES=         # 1 = test mode also returns dev_code in the response (never in production)
DATABASE_URL_UNPOOLED=  # optional, used for schema migrations

# Push alerts (APNs) and daily check
APNS_KEY=               # PEM of the .p8 key
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=app.wishfit.ios
APNS_ENV=production     # sandbox -> api.sandbox.push.apple.com
CRON_SECRET=            # Bearer secret for /cron/daily (Vercel sends it to cron paths)

# IDEALO_FALLBACK=snapshot: while live idealo is down, answer matching wishes from the stored demo snapshots (marked as snapshot)
IDEALO_FALLBACK=

# Price source: idealo (default, idealo MCP) or apify (actors memo23/idealo-scraper + ahmed_jasarevic/idealo-scraper)
PRICE_SOURCE=
APIFY_TOKENS=           # comma separated account tokens, round-robin
APIFY_HISTORY=          # 1 = also run the 90 s price-history actor
MODEL_PRICES=           # optional JSON {"model": [usd_in_per_1M, usd_out_per_1M]}
