# idealo MCP (streamable HTTP or SSE endpoint)
IDEALO_MCP_URL=
# optional, if the MCP needs a token: sent as "Authorization: Bearer ..."
IDEALO_MCP_TOKEN=

# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=

# Neon Postgres (set by the Vercel integration in production). Empty = in-memory store for local dev.
DATABASE_URL=
